# GitHub Actions CI 模拟环境（本地文件版）
# 基于 .github/workflows/build.yml 的 ubuntu:22.04
FROM ubuntu:22.04

LABEL maintainer="TEKINTIAN <tekintian@gmail.com>"
LABEL description="GitHub Actions CI 模拟环境 - 用于复现 iptables 编译问题"
LABEL version="ci-sim-1.2"

# 环境变量（模拟 GitHub Actions）
ENV DEBIAN_FRONTEND=noninteractive \
    LC_ALL=en_US.UTF-8 \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US.UTF-8 \
    TZ=Asia/Shanghai

# GitHub Actions 模拟环境变量（关键！）
ENV GITHUB_WORKSPACE="/home/runner/work/padavan/padavan" \
    GITHUB_RUNNER="actions-runner" \
    GITHUB_ACTIONS="true" \
    GITHUB_REPOSITORY="padavan" \
    GITHUB_REF="refs/heads/dev" \
    CI="true"

# ccache action 模拟环境变量（关键！这些变量会导致编译问题）
ENV CCACHE_DIR="/github/home/ccache" \
    CCACHE_BASEDIR="/home/runner/work/padavan/padavan" \
    CCACHE_COMPILERCHECK="content" \
    CCACHE_MAXSIZE="2G" \
    CCACHE_SLOPPINESS="include_file_mtime,include_file_ctime,time_macros"

# 构建参数
ARG APT_MIRROR_HOST=mirrors.aliyun.com

# 第一步：安装基础依赖
RUN set -eux && \
    # 替换 APT 镜像源
    sed -i "s|archive.ubuntu.com|${APT_MIRROR_HOST}|g; s|security.ubuntu.com|${APT_MIRROR_HOST}|g" /etc/apt/sources.list && \
    # 安装编译依赖（与 build.yml 第37行一致）
    apt update -y -q && \
    apt install -y -q --no-install-recommends \
        # build.yml 指定的工具
        libtool-bin gperf python3-docutils autopoint gettext ccache \
        # 编译工具链
        build-essential cmake autoconf automake libtool \
        bison flex bc texinfo help2man \
        # 系统库依赖
        zlib1g-dev libssl-dev libncurses5-dev libncursesw5-dev \
        libgmp3-dev libmpc-dev libmpfr-dev libltdl-dev \
        # 其他工具
        locales git curl wget unzip cpio fakeroot kmod vim nano htop xxd && \
    # 配置时区和编码
    ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && \
    echo ${TZ} > /etc/timezone && \
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen && \
    # 清理缓存
    apt autoremove -y && \
    apt clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# 第二步：创建 GitHub Actions 目录结构（关键！模拟污染路径）
RUN set -eux && \
    # 创建 GitHub Actions 工作目录（这些路径会被硬编码到 libtool 脚本中）
    mkdir -p /home/runner/work/padavan/padavan && \
    mkdir -p /github/home/ccache && \
    # 创建 runner 用户（模拟 GitHub Actions）
    useradd -m -s /bin/bash runner && \
    # 设置权限
    chown -R runner:runner /home/runner && \
    chown -R runner:runner /github && \
    # 创建软链接到 /padavan（与现有环境一致）
    ln -sf /home/runner/work/padavan /padavan

# 第三步：复制本地文件（从 files 文件夹）
COPY files/ /tmp/local-files/

RUN set -eux && \
    # 安装工具链files/
    if [ -f "/tmp/local-files/mipsel-linux-musl_4.4.x.tar.xz" ]; then \
        mkdir -p /usr/local/mipsel-toolchain-4.4.x && \
        tar -xJf /tmp/local-files/mipsel-linux-musl_4.4.x.tar.xz -C /usr/local/mipsel-toolchain-4.4.x && \
        chmod +x -R /usr/local/mipsel-toolchain/bin/ && \
        mkdir -p /padavan/toolchain/toolchain-mipsel && \
        ln -s /usr/local/mipsel-toolchain-4.4.x /padavan/toolchain/toolchain-mipsel/toolchain-4.4.x; \
        echo "✅ 工具链安装完成"; \
    else \
        echo "⚠️  工具链文件不存在：/tmp/local-files/mipsel-linux-musl_4.4.x.tar.xz"; \
    fi && \
    # 安装 Go（如果存在）
    if [ -f "/tmp/local-files/go*.linux-amd64.tar.gz" ]; then \
        tar -C /usr/local -xzf /tmp/local-files/go*.linux-amd64.tar.gz && \
        echo "✅ Go 安装完成"; \
    else \
        echo "⚠️  Go 文件不存在，跳过安装"; \
    fi && \
    # 安装 Node.js（如果存在）
    if [ -f "/tmp/local-files/node*-linux-x64.tar.xz" ]; then \
        tar -C /usr/local -xf /tmp/local-files/node*-linux-x64.tar.xz && \
        echo "✅ Node.js 安装完成"; \
    else \
        echo "⚠️  Node.js 文件不存在，跳过安装"; \
    fi && \
    # 清理临时文件
    rm -rf /tmp/local-files

# 第四步：设置环境变量 PATH
ENV PATH="/usr/local/go/bin:/usr/local/node/bin:/usr/local/mipsel-toolchain/bin:/padavan/toolchain/toolchain-mipsel/toolchain-4.4.x/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# 第五步：验证环境并创建测试脚本
RUN set -eux && \
    echo "======================================" && \
    echo "✅ GitHub Actions CI 模拟环境就绪！" && \
    echo "🏃‍♂️ Runner 用户：runner" && \
    echo "📁 工作目录：${GITHUB_WORKSPACE}" && \
    echo "💨 ccache 版本：$(ccache --version | head -n1)" && \
    echo "🔗 编译器：$(mipsel-linux-musl-gcc --version 2>/dev/null | head -n1 || echo '未安装')" && \
    echo "🔧 Go 版本：$(go version 2>/dev/null || echo '未安装')" && \
    echo "📦 Node 版本：$(node --version 2>/dev/null || echo '未安装')" && \
    echo "🌐 PATH：${PATH}" && \
    echo "📊 CCACHE_DIR：${CCACHE_DIR}" && \
    echo "🔥 CI 污染路径：${GITHUB_WORKSPACE}" && \
    echo "======================================" && \
    # 创建测试脚本来验证环境污染
    echo '#!/bin/bash' > /tmp/test_ci_pollution.sh && \
    echo 'echo "=== CI 环境污染测试 ==="' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "🏃‍♂️ 用户：$(whoami)"' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "📁 工作目录：$(pwd)"' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "GITHUB_WORKSPACE: $GITHUB_WORKSPACE"' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "CCACHE_DIR: $CCACHE_DIR"' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "CCACHE_BASEDIR: $CCACHE_BASEDIR"' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "PATH: $PATH"' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "which ccache: $(which ccache)"' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "which sed: $(which sed)"' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "🔧 编译器测试：$(mipsel-linux-musl-gcc --version | head -n1 2>/dev/null || echo "未找到")"' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "💨 ccache 状态："' >> /tmp/test_ci_pollution.sh && \
    echo 'ccache -s 2>/dev/null || echo "ccache 未配置"' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "📋 环境变量检查："' >> /tmp/test_ci_pollution.sh && \
    echo 'env | grep -E "(GITHUB|CCACHE|CI)" | sort' >> /tmp/test_ci_pollution.sh && \
    echo 'echo "=== 测试完成 ==="' >> /tmp/test_ci_pollution.sh && \
    chmod +x /tmp/test_ci_pollution.sh && \
    # 创建编译测试脚本
    echo '#!/bin/bash' > /tmp/test_iptables_compile.sh && \
    echo 'echo "=== iptables 编译测试 ==="' >> /tmp/test_iptables_compile.sh && \
    echo 'cd /padavan/trunk/user/iptables' >> /tmp/test_iptables_compile.sh && \
    echo 'echo "🧹 清理环境..."' >> /tmp/test_iptables_compile.sh && \
    echo 'make clean || true' >> /tmp/test_iptables_compile.sh && \
    echo 'echo "🔧 开始编译 iptables..."' >> /tmp/test_iptables_compile.sh && \
    echo 'make 2>&1 | tee /tmp/iptables_compile.log' >> /tmp/test_iptables_compile.sh && \
    echo 'echo "📋 编译日志保存到：/tmp/iptables_compile.log"' >> /tmp/test_iptables_compile.sh && \
    echo 'echo "=== 编译测试完成 ==="' >> /tmp/test_iptables_compile.sh && \
    chmod +x /tmp/test_iptables_compile.sh

# 设置工作目录
WORKDIR /padavan

# 切换到 runner 用户
USER runner

# 启动命令
CMD ["/bin/bash", "-c", \
    "echo '=== GitHub Actions CI 模拟环境 ==='; \
     echo '🏃‍♂️ 用户：$(whoami)'; \
     echo '📁 工作目录：$(pwd)'; \
     echo '🔧 模拟 CI 环境：GITHUB_ACTIONS=${GITHUB_ACTIONS}'; \
     echo '💨 ccache 配置：CCACHE_DIR=${CCACHE_DIR}'; \
     echo '🔥 污染路径：${GITHUB_WORKSPACE}'; \
     echo '📋 用法：'; \
     echo '  1. 测试环境污染：/tmp/test_ci_pollution.sh'; \
     echo '  2. 测试 iptables 编译：/tmp/test_iptables_compile.sh'; \
     echo '  3. 编译完整固件：make K2P'; \
     echo '  4. 进入容器后查看编译日志：cat /tmp/iptables_compile.log'; \
     echo '======================================'; \
     /bin/bash"]