# Makefile for SNI filter module
# Based on the kernel's built-in Makefile system

obj-m += xt_sni_filter_refactored.o

# Kernel directory
KERNEL_DIR = /lib/modules/$(shell uname -r)/build

# Current directory
PWD = $(shell pwd)

# Default target
all:
	$(MAKE) -C $(KERNEL_DIR) M=$(PWD) modules

clean:
	$(MAKE) -C $(KERNEL_DIR) M=$(PWD) clean

# Install target (for cross-compilation with padavan toolchain)
install:
	@echo "Use the padavan build system to compile this module"
	@echo "Example: docker run -it --name padavan -v /Volumes/csdisk/padavan/trunk:/padavan/trunk tekintian/padavan-compiler:4.4.198"

.PHONY: all clean install